{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "resolveJsonModule": true,
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.js",
    "lib/**/*.js",
    "bin/**/*.js",
    "plugins/be/hooks/scripts/**/*.js",
    "plugins/be/scripts/**/*.js"
  ],
  "exclude": ["node_modules", "plugins/be/templates"]
}
