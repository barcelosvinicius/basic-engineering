node_modules/

# This repository ships a skill about secret handling and had no rule that would
# stop an agent from staging a credentials file. An external scan found it
# (harness-score HYG-02, 2026-09-23). A pattern costs nothing and removes a
# whole class of accident, whether or not this repo ever has an .env.
.env
.env.*
!.env.example

# The be SessionStart hook writes BE-GUIDE.md / BE-GUIDE.pt.md at the root of a
# project that uses the base. This repo *is* the base: the canonical guides live
# in plugins/be/ and are generated by `npm run gen:guide`. Committing the root
# copies would mean two files that must stay in sync by hand — the exact drift
# the guide's own drift check exists to prevent.
/BE-GUIDE.md
/BE-GUIDE.pt.md

# Local links from .claude/ to the working tree (npm run dev:link). A symlink
# in git is a cross-platform trap; these stay on the machine that made them.
/.claude/skills
/.claude/agents
/.claude/commands
/.claude/settings.local.json
